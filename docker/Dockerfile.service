# Shared build for every backend service (Identity, Appointment, Availability,
# Payment, Notification, Admin, Search, Document, Review). Build context is
# the repo root so ProjectReference'd shared projects (LandaDoc.Shared) resolve.
#
# Build args:
#   PROJECT_PATH   e.g. src/Services/Identity/LandaDoc.Identity.csproj
#   ASSEMBLY_NAME  e.g. LandaDoc.Identity

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG PROJECT_PATH
WORKDIR /src
COPY . .
RUN dotnet publish "$PROJECT_PATH" -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
ARG ASSEMBLY_NAME
ENV ASSEMBLY_NAME=${ASSEMBLY_NAME}
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT dotnet ${ASSEMBLY_NAME}.dll
