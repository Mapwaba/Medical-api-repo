# Copy to .env on the VPS and fill in real values. Never commit the real .env.
# Generate strong random values for every secret below, e.g.:
#   openssl rand -base64 32

DOMAIN=landadoc.fr

# Shared JWT signing key — must be identical across all 9 backend services.
JWT_SECRET=

# Postgres (all 8 database-backed services share one database)
POSTGRES_PASSWORD=

# RabbitMq (all services)
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MinIO (Document service's object storage)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Payment: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment: MokoAfrika mobile-money gateway
MOKOAFRIKA_MERCHANT_ID=
MOKOAFRIKA_MERCHANT_SECRET=
MOKOAFRIKA_HMAC_KEY=
MOKOAFRIKA_AES_KEY=

# Notification: Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Notification: SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM=
